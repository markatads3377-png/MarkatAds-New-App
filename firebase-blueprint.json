{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in Mark@Ads marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "displayName": { "type": "string", "maxLength": 100 },
        "company": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username", "createdAt", "updatedAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Ad space listing created by media owners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "medium": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "size": { "type": "string", "maxLength": 100 },
        "pricePerMonth": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "available": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "secondHand": { "type": "boolean" },
        "images": { "type": "array" },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 30 },
        "views": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "sellerId",
        "title",
        "medium",
        "city",
        "country",
        "pricePerMonth",
        "available",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Space reservation/booking by an advertiser",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "buyerId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "maxLength": 30 },
        "message": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "listingId", "buyerId", "startDate", "endDate", "status", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Direct inquiry sent by buyer to seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "buyerId": { "type": "string" },
        "body": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "listingId", "buyerId", "body", "createdAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Saved listing for quick access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "listingId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "listingId", "createdAt"]
    },
    "FeedPost": {
      "title": "FeedPost",
      "description": "Community OOH sighting post with photos, videos, and medium insights",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 3000 },
        "mediaType": { "type": "string", "maxLength": 20 },
        "mediaUrl": { "type": "string", "maxLength": 1000 },
        "oohMedium": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 150 },
        "linkedListingId": { "type": "string", "maxLength": 100 },
        "linkedListingTitle": { "type": "string", "maxLength": 150 },
        "coinsRewarded": { "type": "number" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "authorId",
        "title",
        "mediaType",
        "mediaUrl",
        "oohMedium",
        "city",
        "createdAt"
      ]
    },
    "FeedComment": {
      "title": "FeedComment",
      "description": "Comment and audience inquiry on a community OOH post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorAvatar": { "type": "string", "maxLength": 500 },
        "text": { "type": "string", "maxLength": 1500 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "text", "createdAt"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "OOH coin reward or redemption transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "action": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "action", "createdAt"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Public advertising space listings"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Ad space bookings and campaign reservations"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Buyer inquiries to media owners"
    },
    "/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "User favorite listings"
    },
    "/feed_posts/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Community feed OOH sighting posts"
    },
    "/feed_comments/{commentId}": {
      "schema": { "$ref": "#/entities/FeedComment" },
      "description": "Comments left on feed posts"
    },
    "/coin_transactions/{txId}": {
      "schema": { "$ref": "#/entities/CoinTransaction" },
      "description": "Ledger of earned and redeemed OOH coins"
    }
  }
}
