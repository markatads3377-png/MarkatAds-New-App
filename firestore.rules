rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test Connection Document
    match /test/{testId} {
      allow read: if true;
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.id == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 50;
      allow update: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 50;
      allow delete: if isOwner(userId);
    }

    // Listings Collection
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(listingId)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.pricePerMonth is number
        && request.resource.data.pricePerMonth >= 0;
      allow update: if isSignedIn()
        && (resource.data.sellerId == request.auth.uid)
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // Feed Posts Collection (Community Sightings & Medium Insights)
    match /feed_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(postId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150
        && request.resource.data.mediaType in ['photo', 'video']
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 1000;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Feed Comments Collection
    match /feed_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(commentId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1500;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Coin Transactions Collection
    match /coin_transactions/{txId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(txId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number;
      allow update: if false;
      allow delete: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
      );
      allow create: if isSignedIn()
        && isValidId(bookingId)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string;
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
      ) && request.resource.data.buyerId == resource.data.buyerId;
      allow delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
      );
      allow create: if isSignedIn()
        && isValidId(inquiryId)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
    }

    // Favorites Collection
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(favoriteId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
