{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markatads",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "vars": {
    "NODE_VERSION": "20"
  },
  "routes": [
    {
      "pattern": "*markatads.com/*",
      "custom_domain": true
    }
  ]
}
